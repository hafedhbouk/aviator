{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aviator/gestion",
    "type": "project",
    "description": "Aviator : application de gestion de location de voitures (lot 1 back-office, lot 2 espace client).",
    "keywords": [
        "aviator",
        "location",
        "laravel",
        "filament"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0",
        "filament/filament": "^5.11",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-settings": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"@unlink('storage/framework/cache/pint.cache');\"",
            "@php vendor/bin/pint --test --cache-file=storage/framework/cache/pint.cache",
            "@php vendor/bin/phpstan clear-result-cache --quiet",
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "@php artisan config:clear --ansi",
            "@php artisan test",
            "@composer audit",
            "npm run build"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.16"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "check": "Contrôles de la CI, sans cache : Pint, Larastan, Pest (MariaDB), composer audit, npm run build"
    }
}

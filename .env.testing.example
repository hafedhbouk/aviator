# Copier en .env.testing (ignoré par Git), puis : php artisan key:generate --env=testing
# Les tests tournent sur MariaDB 10.11, jamais sur SQLite.
APP_NAME=Aviator
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=https://aviator.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aviator_test
DB_USERNAME=aviator
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Clé HMAC des empreintes de recherche (D8), propre à chaque environnement.
# Générer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
AVIATOR_BLIND_INDEX_KEY=

MAIL_MAILER=array
